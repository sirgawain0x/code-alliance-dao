# Graph API Key for DAO Hooks
NEXT_PUBLIC_GRAPH_KEY=your_graph_key_here

# Sequence API Key for DAO Hooks
NEXT_PUBLIC_SEQUENCE_KEY=your_sequence_key_here

# Reown (WalletConnect) Project ID — required for production DAO wallet connect
# Get one at https://dashboard.reown.com
NEXT_PUBLIC_REOWN_PROJECT_ID=your_reown_project_id_here
# Legacy alias (optional; NEXT_PUBLIC_REOWN_PROJECT_ID takes precedence)
# NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=your_reown_project_id_here

# CRTVAI MeToken mint on /buy is always enabled in code (see CRTV_PURCHASES_ENABLED).
